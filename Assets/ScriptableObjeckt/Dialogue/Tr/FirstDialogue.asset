  m_Script: {fileID: 11500000, guid: 86c1195f1f0b9ca4d9d5b0058e396e66, type: 3}
  m_Name: FirstDialogue
  m_EditorClassIdentifier: 
  textDialogue:
  - 'Oh, Noob, merhaba. Ben Pro.

'
  - "Sana ma\u011Fazay\u0131 nas\u0131l y\xF6netece\u011Fini \xF6\u011Fretece\u011Fim.\n"
  - 'Al, biraz para.

'
  - "Bu, elma a\u011Fac\u0131 almak i\xE7in yeterli olmal\u0131.\n"
  - "Sat\u0131n alma noktas\u0131na git ve \xFCzerine \xE7\u0131k.\n"
  - "(Bu, yerdeki beyaz \xE7er\xE7eve.)\n"
  - 'Seni burada bekliyorum.

'
  ifFinishDialogue: 0
