  m_Script: {fileID: 11500000, guid: 86c1195f1f0b9ca4d9d5b0058e396e66, type: 3}
  m_Name: MainDialogue
  m_EditorClassIdentifier: 
  textDialogue:
  - "\u041E\u0445, \u041D\u0443\u0431\u0438\u043A, \u0443 \u043C\u0435\u043D\u044F
    \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u043E\u0442\u043B\u0438\u0447\u043D\u0430\u044F
    \u043D\u043E\u0432\u043E\u0441\u0442\u044C."
  - "\u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u043C\u043D\u0435 \u0431\u0443\u0442\u044B\u043B\u043E\u0447\u043A\u0443
    \u043C\u043E\u043B\u043E\u043A\u043E, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."
  - "\u042F \u0441\u043E\u0432\u0441\u0435\u043C \u0432\u044B\u0434\u043E\u0445\u043B\u0430\u0441\u044C,
    \u043F\u043E\u043A\u0430 \u0431\u0435\u0436\u0430\u043B\u0430 \u043A \u0442\u0435\u0431\u0435
    \u0441 \u043D\u043E\u0432\u043E\u0441\u0442\u044C\u044E."
  ifFinishDialogue: 0
