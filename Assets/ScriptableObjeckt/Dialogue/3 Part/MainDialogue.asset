  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 86c1195f1f0b9ca4d9d5b0058e396e66, type: 3}
  m_Name: MainDialogue
  m_EditorClassIdentifier: 
  textDialogue:
  - "\u041E\u0445, \u041D\u0443\u0431\u0438\u043A, \u0434\u043E\u0440\u043E\u0433\u043E\u0439,
    \u0431\u0435\u0434\u0430 \u0441\u043B\u0443\u0447\u0438\u043B\u0430\u0441\u044C."
  - "\u041F\u0420\u041E \u043F\u043E\u0445\u0438\u0442\u0438\u043B\u0438!!!"
  - "\u0417\u043B\u043E\u0439 \u0427\u0438\u0442\u0435\u0440 \u0434\u043E\u0431\u0430\u0432\u0438\u043B
    \u0441\u043D\u043E\u0442\u0432\u043E\u0440\u043D\u043E\u0435 \u0432 \u043A\u0440\u0443\u0436\u043A\u0443
    \u0441 \u0447\u0430\u0435\u043C \u041F\u0420\u041E."
  - "\u041E\u043D \u0437\u0430\u043F\u0435\u0440 \u043C\u043E\u0435\u0433\u043E \u0432\u043D\u0443\u0447\u043A\u0430
    \u0432 \u0441\u0432\u043E\u0435\u043C \u043F\u043E\u0434\u0432\u0430\u043B\u0435."
  - "\u041A\u0430\u043A \u043E\u043D \u043C\u043E\u0433 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u0442\u044C
    \u0441 \u043D\u0438\u043C."
  - "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0434\u043E \u0435\u0433\u043E
    \u0441\u043F\u0430\u0441\u0442\u0438 \u043B\u044E\u0431\u043E\u0439 \u0446\u0435\u043D\u043E\u0439."
  - "\u042F \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C,
    \u0432 \u043A\u0430\u043A\u043E\u043C \u043F\u043E\u0434\u0432\u0430\u043B\u0435
    \u0434\u0435\u0440\u0436\u0430\u0442 \u043C\u043E\u0435\u0433\u043E \u0432\u043D\u0443\u043A\u0430"
  - "\u0422\u044B \u043F\u043E\u043A\u0430 \u0442\u043E\u0436\u0435 \u0447\u0442\u043E
    \u043D\u0438\u0431\u0443\u0434\u044C \u0443\u0437\u043D\u0430\u0439."
  - "\u041F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F \u043D\u0430\u0439\u0442\u0438
    \u043B\u044E\u0434\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u043C\u043E\u0433\u0443\u0442
    \u043D\u0430\u043C \u0441\u043F\u0430\u0441\u0438\u0431\u043E \u0435\u0433\u043E
    \u0438\u0437 \u043F\u043E\u0434\u0432\u0430\u043B\u0430."
  - "\u041B\u0430\u0434\u043D\u043E, \u044F \u043F\u043E\u0439\u0434\u0443, \u0430
    \u0442\u043E \u043F\u043B\u043E\u0445\u043E \u043C\u043D\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E."
  ifFinishDialogue: 0
