  m_Script: {fileID: 11500000, guid: 86c1195f1f0b9ca4d9d5b0058e396e66, type: 3}
  m_Name: MainDialogue
  m_EditorClassIdentifier: 
  textDialogue:
  - "\u0419\u0435\u0435\u0435\u0435\u0445\u0445\u0430!!!"
  - "\u041D\u0443\u0431\u0438\u043A, \u043F\u0440\u0438\u0432\u0435\u0442 \u0441\u043D\u043E\u0432\u0430."
  - "\u0410 \u0434\u043B\u044F \u043A\u043E\u0433\u043E \u0441\u0442\u043E\u043B
    \u043D\u0430\u043A\u0440\u044B\u0442?"
  - "\u0410\u0430\u0430\u0430\u0430"
  - "\u041D\u0443 \u044F \u0433\u0443\u043B\u044F\u043B \u0442\u0443\u0442  \u0441
    \u043B\u043E\u0448\u0430\u0434\u044C\u043C\u0438 \u043A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u043E."
  - "\u0418 \u043D\u0430\u0448\u0435\u043B \u043C\u043E\u044E \u043B\u044E\u0431\u0438\u043C\u0443\u044E
    \u044F\u0433\u043E\u0434\u0443."
  - "\u042D\u0442\u043E \u0441\u0430\u043C\u0430\u044F \u0432\u043A\u0443\u0441\u043D\u0430\u044F
    \u044F\u0433\u043E\u0434\u0430 \u043D\u0430 \u0441\u0432\u0435\u0442\u0435."
  - "\u0413\u043E\u0441\u0442\u044C \u0431\u0443\u0434\u0435\u0442 \u0431\u0435\u0437
    \u0443\u043C\u0430 \u043E\u0442 \u043D\u0435\u0435."
  - "\u0412\u043E\u0442, \u0441\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u043B\u043E\u0436\u0443
    \u043D\u0430 \u0441\u0442\u043E\u043B."
  - "\u041F\u043E\u0442\u043E\u043C \u0441\u043E\u043E\u0431\u0449\u0438, \u043A\u0430\u043A
    \u043F\u0440\u043E\u0448\u043B\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430."
  - "\u041B\u0430\u0434\u043D\u043E, \u044F \u043F\u043E\u0448\u0435\u043B."
  - "\u041A\u0441\u0442\u0430\u0442\u0438, \u043B\u043E\u0448\u0430\u0434\u044F\u043C
    \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C
    \u0442\u0432\u043E\u044F \u043F\u0448\u0435\u043D\u0438\u0446\u0430, \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439
    \u0432 \u0442\u043E\u043C \u0436\u0435 \u0434\u0443\u0445\u0435."
  ifFinishDialogue: 0
