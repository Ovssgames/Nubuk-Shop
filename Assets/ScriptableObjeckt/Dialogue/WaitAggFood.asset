  m_Script: {fileID: 11500000, guid: 86c1195f1f0b9ca4d9d5b0058e396e66, type: 3}
  m_Name: WaitAggFood
  m_EditorClassIdentifier: 
  textDialogue:
  - "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043D\u0438\u043A\u043E\u0433\u0434\u0430
    \u043D\u0435 \u0437\u0430\u0434\u0443\u043C\u044B\u0432\u0430\u043B\u0441\u044F."
  - "\u0415\u0434\u044F\u0442 \u043B\u0438 \u043A\u0443\u0440\u0438\u0446\u044B \u044F\u0431\u043B\u043E\u043A\u0438."
  - "\u041E\u043D\u0438 \u043D\u0430\u0432\u0435\u0440\u043D\u043E \u0432\u0441\u0435
    \u0435\u0434\u044F\u0442."
  - "\u041E\u043D\u0438 \u0436\u0435 \u043A\u0443\u0440\u0438\u0446\u044B..."
  - "\u0410, \u041D\u0443\u0431\u0438\u043A, \u0442\u044B \u043C\u0435\u043D\u044F
    \u043D\u0430\u043F\u0443\u0433\u0430\u043B."
  - "\u0427\u0435\u0433\u043E \u0441\u0442\u043E\u0438\u0448\u044C?"
  - "\u0418\u0434\u0438 \u043F\u043E\u043A\u043E\u0440\u043C\u0438 \u043A\u0443\u0440\u0438\u0446"
  - "\u041A\u0430\u043A \u0440\u0430\u0437 \u0443\u0437\u043D\u0430\u0435\u043C,
    \u0435\u0434\u044F\u0442 \u043B\u0438 \u043E\u043D\u0438 \u044F\u0431\u043B\u043E\u043A\u0438."
  isCycle: 1
