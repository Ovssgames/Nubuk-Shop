  m_Name: FirstDialogue
  m_EditorClassIdentifier: 
  textDialogue:
  - 'Oh, Noob, hi. I''m Pro.

'
  - 'I''ll teach you how to manage the store.

'
  - 'Here, take some money.

'
  - 'This should be enough to buy an apple tree.

'
  - 'Go to the purchase spot and stand on it.

'
  - '(It''s a white frame on the floor.)

'
  - 'I''ll wait for you here.

'
  ifFinishDialogue: 0
